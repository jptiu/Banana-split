{
  "name": "my-app",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:create": "node-pg-migrate create --migrations-dir src/migrations",
    "migrate:up": "node-pg-migrate up --migrations-dir src/migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir src/migrations",
    "seed": "tsx src/seeders/admin-seeder.ts",
    "truncate:table": "tsx scripts/truncate-table.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "hono": "^4.10.6",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^8.0.3",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "plaid": "^39.1.0",
    "stripe": "^20.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  }
}
