# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=3000
APP_ENV=development

# Frontend URL (React)
APP_URL=http://localhost:5173

# ==============================================
# POSTGRES DATABASE
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=your_db_password
DB_NAME=bananasplits

# Optional full connection string
DATABASE_URL=postgres://appuser:your_db_password@localhost:5432/bananasplits

# ==============================================
# JWT AUTHENTICATION SECRETS
# ==============================================
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# ==============================================
# PLAID CONFIGURATION
# ==============================================
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# If you use OAuth redirect (optional)
PLAID_REDIRECT_URI=http://localhost:3000/callback

# Public webhook URL (ngrok or production URL)
PLAID_SANDBOX_WEBHOOK_URL=https://your-ngrok-or-production-url/api/plaid/webhook

# ==============================================
# STRIPE CONFIGURATION
# ==============================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ==============================================
# EMAIL SERVICE CONFIGURATION (Optional)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@banana-split.com

# ==============================================
# IP HASHING SECRET
# ==============================================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=your_ip_hash_secret_here
