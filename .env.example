# ==============================================
# JWT AUTHENTICATION SECRETS
# ==============================================
# CRITICAL SECURITY: Generate strong, random secrets for production
# Use a password generator or run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# These secrets MUST be at least 32 characters long

# Access token secret (used for short-lived tokens - 15 minutes)
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-change-this-in-production

# Refresh token secret (used for refresh tokens - 7 days)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-this-in-production

